{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Balto Speedrunner",
  "version": "0.1.2",
  "identifier": "com.adore.balto-speedrunner.mac",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Balto Speedrunner",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:3080 http://127.0.0.1:30100; frame-src http://127.0.0.1:3080 http://localhost:3080"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Adore LLC",
    "copyright": "Copyright 2026 Adore LLC",
    "category": "DeveloperTool",
    "shortDescription": "High-speed local coding agent for Apple Silicon",
    "longDescription": "Installs and runs an optimized Qwen 3.8 27B coding stack on supported Apple Silicon Macs.",
    "resources": {
      "../runtime/": "runtime/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "dmg": {
        "background": "dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 330, "y": 240 },
        "applicationFolderPosition": { "x": 900, "y": 900 }
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MTUzRjU4ODZGNkUyNjEKUldSaDR2YUdXRDhWMlRMTm1Kd0p2QXJtNEc1Q0M4Y3hpSFdZYThyaEpuT2Y2U1pEQkRHaUQrNGcK",
      "endpoints": [
        "https://github.com/jtc268/balto-speedrunner-mac/releases/latest/download/latest.json"
      ]
    }
  }
}
